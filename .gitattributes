# normalize to LF in the repository; working tree keeps LF on checkout too
* text=auto eol=lf

*.c      text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
Makefile text eol=lf
*.service text eol=lf
*.modules text eol=lf
LICENSE  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
